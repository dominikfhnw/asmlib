%imacro OLDprintstrsafe arg(1)
	pusha
	printstr %1
	popa
%endmacro

%imacro dbg arg(2)
	reg_push
	pusha
	;rtaint
	puts	%1, %2
	popa
	reg_pop
%endmacro

%imacro dbg arg(1)
	reg_push
	rtaint
	%if 0
		movd	mm0, eax
		movd	mm1, ebx
		movd	mm2, ecx
		movd	mm3, edx
	%else
		pusha
	%endif
	rodatastring	sc_arg2, %1	
	puts		x, %strlen(%1)
	%if 0
		movd	eax, mm0
		movd	ebx, mm1
		movd	ecx, mm2
		movd	edx, mm3
	%else
		popa
	%endif
	reg_pop
%endmacro

%imacro printstr arg(1)
	;pusha
	;%strcat string %1, `\n`
	%strcat %%string %1
	%strlen %%pr_strlen %%string
	%if %%pr_strlen < 5
		push	%%string
		puts	esp, %%pr_strlen
		%if stack_cleanup
			pop	ecx
		%endif
	%else
		inline_str %%string
		;%assign printstr_old reg_keepflags
		;%assign reg_keepflags 1
		taint	ecx
		puts	pop, %%pr_strlen
		;%assign reg_keepflags printstr_old
		;popa
	%endif

%endmacro

%imacro ddprint arg(1)
	pusha
	pushf
	printstr %1
	popf
	popa
%endmacro

%macro cpuidstuff arg(0)
	%if 0
		;set edi, 0x80000000
		set edi, 0

		doloop 64
			push ecx
			mov eax, ecx
			add eax, edi
			mov ebp, ecx
			add ebp, edi

			;call regdump
			cpuid
			call regdump
			pop ecx
		endloop
		mov eax, edi
		set ebx,12
		set edx,12
		cpuid
		call regdump
		exit
	%endif
%endmacro

%define zerostring 0
%define printstatic_used 0

%macro printstatic arg(1)
	%assign printstatic_used printstatic_used+1
	%if zerostring
	%strcat string %1, `\0`
	%else
	%strcat string %1
	%endif

	%strlen pr_strlen string
	call printstatic_func
	%if zerostring == 0
	db pr_strlen
	%endif
	db string
	%%endstring:
%endmacro

; stack:
; -strlen
; -return address
; -flags
; -registers
%macro import_printstatic 0
%warning PRINTSTATIC USED printstatic_used
printstatic_func:
%if printstatic_used > 0
	%if DEBUG
		times 8 db 0x90
	%endif
	pushf
	pusha
	rtaint

	;%defalias set setfz
	%if zerostring == 0
		; zero: eax, ebx, edx
		; clobbered: eax,ebx,ecx,edx
		zero	eax, ebx, ecx, edx

		mov     ecx, 4*9[esp] 
		;lea	ebx, 4*9[esp] 
		;add	esp, 4*9
		;mov     ecx, [esp] 
		;exit
		mov     dl, [ecx]
		inc	ecx
		;call	regdump
		puts	ecx, edx

		add     ecx, edx
		mov     4*9[esp], ecx

		;mov     [esp], edx
		;sub	esp, 4*9
		;call	regdump
		;%undefalias set
		;exit
		;db 0xA3, 1, 2, 3, 4, 5, 6
	%elif 0
		; zero: eax, ebx, edx
		zero	eax, ebx, ecx, edx

		lea	esi, 4*9[esp]
		;push	4*9
		;pop	esi
		;add	esi, esp
		;call	regdump
		;exit

		mov	edi, [esi]
		;mov	edi, 4*9[esp]
		mov	ecx, edi
		db	0xA8
		.l:
		inc	edx
		scasb
		jnz	.l
		puts	ecx, edx
		;call	regdump
		;mov	4*9[esp], edi
		mov	[esi], edi

	%else
		; zero: eax, ebx, ecx, edx
		zero	eax, ebx, ecx, edx

		mov	edi, 4*9[esp]
		push	edi
		;mov	esi, edi
		dec	ecx
		repne	scasb
		;call	regdump

		sub	edx, ecx
		dec	edx
		dec	edx

		;lea	edx, [ecx+5]
		;call regdump
		pop	ecx

		puts	ecx, edx
		mov	4*9[esp], edi

	%endif
	;%undefalias set
	popa
	popf
	ret
	
%endif
%endmacro

%imacro dprint arg(1)
	%if DEBUG
		%defstr line __LINE__
		%strcat string "DBG ", __FILE__, ":", line, ": ", %1, `\n`
		pusha
		pushf
		printstr string
		popf
		popa
	%endif
%endmacro


%macro dbgstring arg(1)
	[section .rodata align=1]
	%%str: db %strcat(`\n`,%1), 0
	%%pos: dd %%str + 1
	;%%end:
	__?SECT?__
	movd	DEBUG_STRING_REGISTER, [%%pos]
%endmacro

%macro get_debug_string arg(1)
	movd	%1, DEBUG_STRING_REGISTER
	taint	%1
	pxor	DEBUG_STRING_REGISTER, DEBUG_STRING_REGISTER
%endmacro

%macro print_debug_string arg(0)
	get_debug_string edi
	dec	edi
	js	%%skip
	strlen	edi, sc_arg3, sc_arg2
	write	STDERR, sc_arg2, sc_arg3
	%%skip:
%endmacro

%macro saveregisters arg(0)
	vmovdqu	ymm6, [esp-32]
	pusha
	vmovdqu	ymm5, [esp]
	%if 0
		vmovdqu	[esp], ymm6
		add	esp, 32
	%else
		popa
		vmovdqu	[esp-32], ymm6
	%endif
%endmacro

%macro restoreregisters arg(0)
	vmovdqu	ymm6, [esp-32]
	pusha
	vmovdqu	[esp], ymm5
	popa
	vmovdqu	[esp-32], ymm6

%endmacro

; base64:	6 bit stored in 8 bits
; this thing:	32 bit stored into 48 bit
;		5.33 bit in 8 bits

%macro input 0
	printstr "Press enter to continue"
	push0
	read	0, esp, 1
	pop	ecx
	taint	ecx
%endmacro

