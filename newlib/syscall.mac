%imacro exit arg(0-1) 0
	%if 1 && REG_OPT_LEVEL > 3
		rget sc_nr
		%if reg_val != SYS_exit
			reg_search SYS_exit
			%if reg_search_match != 0
				rget reg_search_match
				ychg	sc_nr, reg_search_match
			%endif
		%endif
	%elif 0 && REG_OPT_LEVEL > 3
		%warning EXIT %0 %1
		rget sc_arg1
		%warning EXIT arg1 reg_val
		%if reg_val == SYS_exit
			%warning EXIT match arg1 reg_val
			rget sc_nr
			%warning EXIT nr reg_val
			%if reg_val != %1
				%warning EXIT match nr reg_val
				reg_search %1
				%if reg_search_match != 0
					rget reg_search_match
					ychg	sc_nr, reg_search_match
					reg_search SYS_exit
					%if reg_search_match != 0
						rget reg_search_match
						ychg	sc_nr, reg_search_match
					%endif
				%endif
			%endif
		%elif reg_val != SYS_exit
			reg_search SYS_exit
			%if reg_search_match != 0
				rget reg_search_match
				ychg	sc_nr, reg_search_match
			%endif
		%endif

	%elif 1 && REG_OPT_LEVEL > 3
		%warning EXIT %0 %1
		rget sc_nr
		%if reg_val != %1
			rget sc_arg1
			%if reg_val != SYS_exit
				reg_search %1
				%if reg_search_match != 0
					rget reg_search_match
					ychg	sc_nr, reg_search_match
					reg_search SYS_exit
					%if reg_search_match != 0
						rget reg_search_match
						ychg	sc_nr, reg_search_match
					%endif
				%endif
			%endif
		%elif reg_val != SYS_exit
			reg_search SYS_exit
			%if reg_search_match != 0
				rget reg_search_match
				ychg	sc_nr, reg_search_match
			%endif
		%endif
	%endif
	syscall SYS_exit, %1
%endmacro

