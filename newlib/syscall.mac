%define	SIG_DFL	0
%define	SIG_IGN	1

%macro signal arg(2)
	push0
	push0
	push	%2
	syscall	SYS_sigaction, %1, esp, 0
	%if stack_cleanup
		pop	ecx
		pop	ecx
		pop	ecx
		rset	ecx, 0
		; ecx, edx = 0
	%endif
%endmacro

%macro sigign arg(1)
	syscall	SYS_signal, %1, 1
%endmacro

%macro brk arg(0-1) 0
	syscall	SYS_brk, %1
%endmacro

%macro sbrk arg(2)
	brk
	lea	sc_arg1, [sc_ret+%2]
	;%ifnidn	sc_ret, %1
		ychg	sc_ret, %1
	;%endif
	taint	sc_arg1
	brk	sc_arg1
%endmacro

%macro sbrk2 arg(2)
	brk
	set	ecx, %2
	lea	sc_arg1, [sc_ret+ecx]
	ychg	sc_ret, %1
	taint	sc_arg1
	brk	sc_arg1
%endmacro

%macro sbrk3 arg(2)
	brk
	set	sc_arg1, %2
	add	sc_arg1, sc_ret
	taint	sc_arg1
	ychg	%1, sc_ret
	brk	sc_arg1
%endmacro

%imacro mmap arg(6)
	syscall SYS_mmap, %1, %2, %3, %4, %5, %6
%endmacro

; but there is no free
%imacro malloc arg(1)
	rget	edx
	%if reg_val > 0 && (reg_val & 3 == 3)
		%warning malloc: edx ok: reg_val
	%else
		mov	dl, PROT_READ|PROT_WRITE
	%endif
	taint	edx

	mmap	x, %1, x, MAP_PRIVATE|MAP_ANONYMOUS, x, x
%endmacro

