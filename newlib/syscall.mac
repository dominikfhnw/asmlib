%imacro setwinsize arg(2)
	push0
	push	%1*256*256 + %2
	ioctl	0, TIOCSWINSZ, esp
	%if stack_cleanup
		pop	edx
		pop	edx
		rset	edx, 0
	%endif
%endmacro

